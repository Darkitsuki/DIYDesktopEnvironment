# Load optional local machine configuration (gitignored)
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/machine-config.env" ]; then
  set -a
  # shellcheck disable=SC1091
  . "${XDG_CONFIG_HOME:-$HOME/.config}/machine-config.env"
  set +a
fi

# Hybrid-GPU DRM priority: honor explicit AQ_DRM_DEVICES; otherwise expose
# /dev/dri/igpu:/dev/dri/dgpu (iGPU first) so Hyprland and desktop apps run on
# Intel Iris Xe while XWayland PRIME retains zero-copy DMA-BUF + Explicit Sync
# access to RTX 3050 Ti. When no dGPU external connector is connected, isolate
# desktop processes to Mesa EGL/Vulkan/GLX.
if [ -z "${AQ_DRM_DEVICES:-}" ] && [ -e /dev/dri/igpu ]; then
  if [ -e /dev/dri/dgpu ]; then
    export AQ_DRM_DEVICES="/dev/dri/igpu:/dev/dri/dgpu"
    _dgpu_card=$(basename "$(readlink -f /dev/dri/dgpu)")
    _dgpu_connected=0
    for _drm_status in /sys/class/drm/"$_dgpu_card"-*/status; do
      if [ -r "$_drm_status" ] && read -r _conn_state < "$_drm_status" && [ "$_conn_state" = "connected" ]; then
        _dgpu_connected=1
        break
      fi
    done
    if [ "$_dgpu_connected" -eq 0 ]; then
      if [ -f /usr/share/glvnd/egl_vendor.d/50_mesa.json ]; then
        export __EGL_VENDOR_LIBRARY_FILENAMES="/usr/share/glvnd/egl_vendor.d/50_mesa.json"
      fi
      export MESA_VK_DEVICE_SELECT="8086:46a6!"
      export __GLX_VENDOR_LIBRARY_NAME="mesa"
    fi
    unset _dgpu_card _dgpu_connected _drm_status _conn_state
  else
    export AQ_DRM_DEVICES="/dev/dri/igpu"
  fi
fi

export XDG_DATA_DIRS="$HOME/.nix-profile/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
