[Unit]
Description=Fast 2-Way Sync of Google Drive to SD Card (optional, excludes Shared Modpack)
ConditionPathExists=%h/.local/bin/mirror-gdrive-sd.sh
ConditionPathExists=%h/.config/rclone/rclone.conf

[Service]
Type=oneshot
TimeoutStopSec=45s
EnvironmentFile=-%h/.config/machine-config.env
ExecStart=%h/.local/bin/mirror-gdrive-sd.sh --fast
