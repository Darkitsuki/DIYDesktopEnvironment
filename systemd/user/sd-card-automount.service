[Unit]
Description=Auto-mount configured SD Card via udisks2 (optional)
ConditionPathExists=%h/.config/machine-config.env
Before=graphical-session.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-%h/.config/machine-config.env
ExecStart=/usr/bin/bash -c 'if [ -z "${DIY_SD_CARD_UUID:-}" ]; then exit 0; fi; dev="/dev/disk/by-uuid/$DIY_SD_CARD_UUID"; [ -e "$dev" ] || exit 0; findmnt -rn "$dev" >/dev/null || /usr/bin/udisksctl mount --no-user-interaction -b "$dev"'
ExecStartPost=-/usr/bin/pkill -RTMIN+12 waybar

[Install]
WantedBy=default.target
